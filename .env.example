# Worker settings
DATA_DIR=/srv/shank/data
POLL_INTERVAL=10

# Chord detection backend: auto (default, librosa), madmom, or disabled
# auto/librosa: uses librosa chroma-based chord estimation (always available)
# madmom:       uses madmom DeepChroma chord recognition (requires madmom installed;
#               falls back to librosa if madmom is not available)
# disabled:     skips chord detection entirely (chords will be empty in results)
CHORD_BACKEND=auto

# Stem backend selection: auto (default), audio_separator, acestep, demucs, or none
# auto: tries Ace-Step first (if configured), then audio-separator, then Demucs
# audio_separator: strict python-audio-separator only — task fails if library unavailable or separation fails
# acestep: strict Ace-Step only — task fails if unavailable
# demucs: strict Demucs only — task fails if unavailable
# none: stem separation disabled
STEM_BACKEND=auto

# Optional ACE-Step stem separation
ACE_STEP_API_URL=
ACE_STEP_API_KEY=
# Comma-separated stem types to separate (e.g. vocals,drums,bass,other)
ACE_STEP_STEMS=vocals,drums,bass,other

# python-audio-separator stem separation (https://github.com/nomadkaraoke/python-audio-separator)
# Included in the container — no external service required.
# Default model separates 4 stems: vocals, drums, bass, other (instruments)
# For 6 stems (adds guitar + piano): AUDIO_SEPARATOR_MODEL=htdemucs_6s.yaml
AUDIO_SEPARATOR_MODEL=htdemucs_ft.yaml
AUDIO_SEPARATOR_MODEL_DIR=/srv/shank/models/separator
AUDIO_SEPARATOR_DEVICE=cpu   # cpu | cuda (GPU: see README for setup)

# Optional Demucs stem separation (legacy; requires demucs installed in PATH: pip install demucs)
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=cpu        # cpu | cuda | mps

# Optional MT3 transcription
MT3_ENABLED=false
MT3_SERVICE_URL=http://127.0.0.1:8090
MT3_MODEL=multi_instrument
TRANSCRIPTION_BACKEND=basic_pitch   # basic_pitch | mt3 | omnizart | disabled
MODEL_CACHE_DIR=/srv/shank/models/transcription
MT3_TIMEOUT=1800
MT3_TRANSCRIBE_STEMS=true
MT3_FAIL_TASK_ON_ERROR=false
# Place downloaded MT3 checkpoints here before starting the container.
MT3_CHECKPOINT_ROOT=/srv/shank/models/mt3/checkpoints
# Runtime cache for compiled MT3 artifacts and other reusable intermediates.
MT3_CACHE_DIR=/srv/shank/cache/mt3
# Generated MIDI and note JSON files are persisted under the shared data volume.
MT3_OUTPUT_PATH=/srv/shank/data/mt3
MT3_DEVICE=auto

# Future: WordPress Build Log integration
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_PASSWORD=
