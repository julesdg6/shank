# Worker settings
DATA_DIR=/srv/shank/data
POLL_INTERVAL=10

# Stem backend selection: auto (default), acestep, demucs, or none
# auto: tries Ace-Step first, falls back to Demucs, then continues without stems
# acestep: strict Ace-Step only — task fails if unavailable
# demucs: strict Demucs only — task fails if unavailable
# none: stem separation disabled
STEM_BACKEND=auto

# Optional ACE-Step stem separation
ACE_STEP_API_URL=
ACE_STEP_API_KEY=
# Comma-separated stem types to separate (e.g. vocals,drums,bass,other)
ACE_STEP_STEMS=vocals,drums,bass,other

# Optional Demucs stem separation (fallback when Ace-Step is unavailable)
# Requires demucs installed in PATH: pip install demucs
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=cpu        # cpu | cuda | mps

# Optional MT3 transcription
MT3_ENABLED=false
MT3_SERVICE_URL=http://shank-mt3:8090
MT3_MODEL=multi_instrument
MT3_TIMEOUT=900
MT3_TRANSCRIBE_STEMS=true
MT3_FAIL_TASK_ON_ERROR=false
MT3_CHECKPOINT_ROOT=/srv/shank/models/mt3/checkpoints
MT3_CACHE_DIR=/srv/shank/cache/mt3
MT3_DEVICE=auto

# Future: WordPress Build Log integration
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_PASSWORD=
